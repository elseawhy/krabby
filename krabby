#!/usr/bin/env bash

readonly KRABBY_SYNC_ENABLED=1
readonly RUST_TARGET="$(rustc -vV | sed -n 's/^host: //p')"
export LDFLAGS="-march=native -fuse-ld=lld -Wl,-O1,--sort-common,--as-needed,-z,relro,-z,now,-z,pack-relative-relocs,-plugin-opt=O3,-plugin-opt=mcpu=native -flto=full"
readonly COMMON_CFLAGS="--target=$(clang -print-target-triple) -ffat-lto-objects -march=native -O3 -pipe -fno-plt -fexceptions -Wp,-D_FORTIFY_SOURCE=3 -Wformat -Werror=format-security -fstack-clash-protection -fstack-protector-strong -fcf-protection -flto=full"
readonly COMMON_RUSTFLAGS="-C target-cpu=native -C opt-level=3 -Zmir-opt-level=4 -C codegen-units=1 -Z unstable-options -C panic=immediate-abort${LDFLAGS:+ -Clink-arg=${LDFLAGS// / -Clink-arg=}}"

_krabby_spin() {
    local spinstr='-\|/'
    while kill -0 "$1" 2>/dev/null; do
        printf '\r\e[K [%s] %s' "${spinstr:0:1}" "$2"
        spinstr="${spinstr:1}${spinstr:0:1}"
        sleep 0.1
    done
    printf '\r\e[K'
    wait "$1" 2>/dev/null
}

_cargo_list() {
    cargo install --list 2>/dev/null | awk '$2 ~ /^v.*:/ {print $1}'
}

_krabby_get_count() {
    echo -n "$1" | tr '\n' '\0' | xargs -0 -r objdump -d 2>/dev/null | wc -l
}

_krabby_sync() {
    (( KRABBY_SYNC_ENABLED )) || return 0
    local pkglist_file="$HOME/dotfiles/pkglist-cargo.txt" new_crates_list="$(_cargo_list)"
    [[ "$1" == "$new_crates_list" ]] && return 0
    mkdir -p "${pkglist_file%/*}"
    echo "$new_crates_list" > "$pkglist_file"
}

_krabby_update() {
    local tmpfile=$(mktemp)
    trap 'rm -f "$tmpfile"' EXIT

    cargo install --list 2>/dev/null | awk -v h="${XDG_CONFIG_HOME:-$HOME/.config}/krabby/hold" '
        BEGIN { while ((getline < h) > 0) held[$1]=1; close(h) }
        $2 ~ /^v.*:/ && !held[$1] {
            namelen = length($1)
            cratever = substr($2, 2, length($2)-2)
            prefix = namelen==1 ? "1/"$1 : namelen==2 ? "2/"$1 : namelen==3 ? "3/"substr($1,1,1)"/"$1 : substr($1,1,2)"/"substr($1,3,2)"/"$1
            latest = ""
            while (("curl -sf https://index.crates.io/" prefix | getline line) > 0) {
                if (match(line, /"vers":"[^"]+"/)) latest = substr(line, RSTART+8, RLENGTH-9)
            }
            close("curl -sf https://index.crates.io/" prefix)
            if (latest != "" && cratever != latest) print $1, cratever, latest
        }' > "$tmpfile" &
    _krabby_spin "$!" "Checking crates.io..."

    if [[ -s "$tmpfile" ]]; then
    	echo "👀 Crates to be upgraded:"
    	awk '{print "  - " $1 ": " $2 " -> " $3}' "$tmpfile"
    	read -rp $'\n🚀 Proceed with upgrade? [Enter to confirm, Ctrl+C to abort] '

    	while read -r crate_name old_version new_version; do
        	_krabby_compile install --force "$crate_name" || echo "Failed to compile $crate_name"
    	done < "$tmpfile"
    else
    	echo "😴 All installed crates are up to date."
	fi
}

_krabby_compile() {
    local cargo_cmd="$1" cargo_arg="$2" bin_target="$3" bin_name="${3%@*}" work_dir=$(mktemp -d) cached_profile=""
    local cache_file_name="${bin_name//\//%}"
    trap 'rm -rf "$work_dir" 2>/dev/null' RETURN
    trap 'rm -rf "$work_dir" 2>/dev/null; exit 130' INT TERM

    if [[ "$cargo_cmd" == "install" ]]; then
    	local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/krabby"
        mkdir -p "$work_dir/stage"
        echo -e "\nStarting Krabby build for: $bin_name (Mode: $cargo_cmd)"
        [[ -f "$cache_dir/$cache_file_name" ]] && read -r cached_profile < "$cache_dir/$cache_file_name" && [[ -n "$cached_profile" ]] && echo "Found global cache: [$cached_profile]"
    else
        echo -e "\nStarting Krabby build for local project (Mode: $cargo_cmd)"
        [[ -f ".krabby" ]] && read -r cached_profile < ".krabby" && [[ -n "$cached_profile" ]] && echo "Found project override: [$cached_profile]"
    fi

    _compile_profile() {
        RUSTC_BOOTSTRAP=1 CC=clang CXX=clang++ AR=llvm-ar RANLIB=llvm-ranlib CFLAGS="$2" CXXFLAGS="$3" RUSTFLAGS="$4" \
        ${5:+timeout} ${5:+"$5"} cargo "$cargo_cmd" --target "$RUST_TARGET" -Z build-std=std,panic_abort --locked --quiet $cargo_arg ${bin_target:+"$bin_target"} > "$work_dir/build.log" 2>&1 &
        _krabby_spin "$!" "Compiling profile: [$1]..." || {
            [[ -n "$5" && $? -eq 124 ]] && return 124
            echo "Build failed for profile [$1]!"
            echo "$(< "$work_dir/build.log")"
            return 1
        }
    }

    if [[ -n "$cached_profile" ]]; then
        echo "Skipping FFI probes. Fast-tracking..."
        if [[ "$cached_profile" == "crosslto" ]]; then
            _compile_profile "crosslto" "$COMMON_CFLAGS" "$COMMON_CFLAGS -D_GLIBCXX_ASSERTIONS" "$COMMON_RUSTFLAGS -C linker=clang -C linker-plugin-lto" || return 1
        else
            _compile_profile "rust" "" "" "$COMMON_RUSTFLAGS" || return 1
        fi
        echo "Final binary built via fast-path [$cached_profile]."
    else
        echo "No cache found. Initiating FFI probes..."
        _compile_profile "crosslto" "$COMMON_CFLAGS" "$COMMON_CFLAGS -D_GLIBCXX_ASSERTIONS" "$COMMON_RUSTFLAGS -C linker=clang -C linker-plugin-lto" || return 1

        if [[ "$cargo_cmd" == "install" ]]; then
            local bin_path=$(cargo install --list 2>/dev/null | awk -v target="$bin_name" -v cargo_bin="${CARGO_HOME:-$HOME/.cargo}/bin" '
                $0 ~ "^" target " v" || index($0, "(" target) {
                    while (getline > 0 && /^[[:space:]]/) {
                        binary_path = cargo_bin "/" $1
                        if (system("test -f \"" binary_path "\"") == 0) print binary_path
                    }
                    exit
                }
            ')
            local count_crosslto=$(_krabby_get_count "$bin_path")
            xargs -d'\n' -r cp -a --target-directory="$work_dir/stage/" <<< "$bin_path"

            _compile_profile "noc" "" "" "$COMMON_RUSTFLAGS -C linker=clang -C linker-plugin-lto"
            local count_noc=$(_krabby_get_count "$bin_path")

            echo "--- PROBE RESULT ---"
            echo "crosslto       : ${count_crosslto:-0}"
            echo "noc (canary)   : ${count_noc:-0}"
            echo "--------------------"

            if [[ "${count_crosslto:-0}" != "${count_noc:-0}" ]]; then
                local winning_profile="crosslto"
                echo "C/C++ dependencies detected. Restoring staged crosslto binary..."
                cp -a "$work_dir/stage/"* "${CARGO_HOME:-$HOME/.cargo}/bin/"
            else
                local winning_profile="rust"
                echo "No C/C++ FFI benefits detected. Compiling pure rust profile..."
                _compile_profile "rust" "" "" "$COMMON_RUSTFLAGS" || return 1
            fi

            mkdir -p "$cache_dir"
            echo "$winning_profile" > "$cache_dir/$cache_file_name"
        else
            echo "Testing incremental cache with noc profile (3s timeout)..."
            _compile_profile "noc" "" "" "$COMMON_RUSTFLAGS -C linker=clang -C linker-plugin-lto" "3s"
            case $? in
                124)
                    echo "Cargo is rebuilding FFI (exceeded 3s)! crosslto takes the crown."
                    local winning_profile="crosslto"
                    ;;
                0)
                    echo "Incremental build finished instantly! No FFI flags mattered."
                    _compile_profile "rust" "" "" "$COMMON_RUSTFLAGS" || return 1
                    local winning_profile="rust"
                    ;;
                *)
                    echo "Probe failed unexpectedly. Aborting."
                    return 1
                    ;;
            esac
            echo "$winning_profile" > .krabby
        fi
    fi
}

_krabby_main() {
    case "${1:-}" in
        help|-h|--help)
            echo '
🦀 krabby package manager - Extreme performance cargo wrapper

Usage:
  krabby [subcommand] [args...]
  krabby [flags...]              (Auto-detects Cargo.toml and runs cargo build)

Subcommands:
  install <crate>... [flags...]  Install crates from crates.io (or via --git) with FFI profiling
  uninstall <crate>...           Uninstall crates
  inject <cmd>                   Execute a command with crosslto profile injected
  update                         Upgrade all installed cargo crates
  list                           List all installed cargo binaries
  hold <crate>...                Prevent a package from being updated
  unhold <crate>...              Allow a package to be updated again
  help, -h                       Show this help message
'
            ;;
        update|upgrade)
            _krabby_update
            ;;
        list)
            echo "📦 Installed Cargo Binaries:"
            cargo install --list
            ;;
        inject)
            shift
            if [[ -z "${1:-}" ]]; then
                echo "Usage: krabby inject <cmd>"
            else
            	RUSTC_BOOTSTRAP=1 CC=clang CXX=clang++ AR=llvm-ar RANLIB=llvm-ranlib \
            	CARGO_UNSTABLE_BUILD_STD="std,panic_abort" CARGO_BUILD_TARGET="$RUST_TARGET" \
            	CFLAGS="$COMMON_CFLAGS" CXXFLAGS="$COMMON_CFLAGS -D_GLIBCXX_ASSERTIONS" RUSTFLAGS="$COMMON_RUSTFLAGS -C linker=clang -C linker-plugin-lto" \
            	exec "$@"
			fi
            ;;
        hold)
            shift
            if [[ -z "${1:-}" ]]; then
                echo "Usage: krabby hold <crate1> <crate2> ..."
			else
            	local hold_file="${XDG_CONFIG_HOME:-$HOME/.config}/krabby/hold"
            	mkdir -p "${hold_file%/*}"
            	for _bin in "$@"; do
                	if grep -qxE "$_bin" "$hold_file" 2>/dev/null; then
                    	echo "$_bin is already held."
                	else
                    	echo "$_bin" >> "$hold_file"
                    	echo "Placed $_bin on hold."
                	fi
            	done
            fi
            ;;
        unhold)
            shift
            local hold_file="${XDG_CONFIG_HOME:-$HOME/.config}/krabby/hold"
            if [[ -z "${1:-}" ]]; then
                echo "Usage: krabby unhold <crate1> <crate2> ..."
            elif [[ ! -f "$hold_file" ]]; then
                echo "Hold list is empty."
			else
            	for _bin in "$@"; do
                	if grep -qxE "$_bin" "$hold_file" 2>/dev/null; then
                    	grep -vxE "$_bin" "$hold_file" > "${hold_file}.tmp"
                    	mv "${hold_file}.tmp" "$hold_file"
                    	echo "Removed hold on $_bin."
                	else
                    	echo "$_bin is not held."
                	fi
            	done
            fi
            ;;
        install)
            shift
            local old_crates_list="$(_cargo_list)" bins=() flags=() parsing_flags=0 arg _bin
            for arg in "$@"; do
                if (( parsing_flags )) || [[ "$arg" == -* ]]; then
                    parsing_flags=1
                    flags+=("$arg")
                else
                    bins+=("$arg")
                fi
            done 
            if [[ ${#bins[@]} -eq 0 ]]; then
                echo "Usage: krabby install <crate1> <crate2> ... [flags...]"
            else
            	for _bin in "${bins[@]}"; do
                	if [[ "$_bin" == http*://* ]]; then
                		arg="--force ${flags[*]} --git"
                	else
                		arg="--force ${flags[*]}"
                	fi
                	_krabby_compile install "$arg" "$_bin" || { 
                    	echo "Install failed for: $_bin"
                    	exit 1
                	}
            	done
            	_krabby_sync "$old_crates_list"
            fi
            ;;
        uninstall)
            shift
            if [[ -z "${1:-}" ]]; then
                echo "Usage: krabby uninstall <crate1> <crate2> ..."
            else
            	local old_crates_list="$(_cargo_list)"
            	for _bin in "$@"; do
                	cargo uninstall "$_bin"
            	done
            	_krabby_sync "$old_crates_list"
            fi
            ;;
        *)
            if [[ -f Cargo.toml ]]; then
            	_krabby_compile build "--release $*" || {
                	echo "Build failed!"
                	exit 1
            	}
           	else
                _krabby_main help
            fi
            ;;
    esac
}

_krabby_main "$@"
