#!/usr/bin/env bash
readonly KRABBY_SYNC_ENABLED=0
trap 'exit 130' INT TERM

export LDFLAGS="-march=native -fuse-ld=mold -Wl,-O1,--sort-common,--as-needed,-z,relro,-z,now,-z,pack-relative-relocs,-plugin-opt=O3,-plugin-opt=mcpu=native -flto"
readonly CARGO_COMMON_ARGS=(--target "$(rustc -vV | sed -n 's/^host: //p')" -Z build-std=std,panic_abort --locked --quiet)
readonly COMMON_CFLAGS="-march=native -O3 -pipe -fno-plt -fexceptions -Wp,-D_FORTIFY_SOURCE=3 -Wformat -Werror=format-security -fstack-clash-protection -fstack-protector-strong -fcf-protection -flto=full"
readonly COMMON_CXXFLAGS="$COMMON_CFLAGS -D_GLIBCXX_ASSERTIONS"
readonly COMMON_RUSTFLAGS="-C target-cpu=native -C opt-level=3 -Zmir-opt-level=4 -C codegen-units=1 -Z unstable-options -C panic=immediate-abort${LDFLAGS:+ -Clink-arg=${LDFLAGS// / -Clink-arg=}}"

spinner() {
    local spinstr='-\|/'
    while kill -0 "$1" 2>/dev/null; do
        echo -en "\r\e[K [${spinstr:0:1}] $2"
        spinstr="${spinstr:1}${spinstr:0:1}"; sleep 0.1
    done
    echo -en "\r\e[K"; wait "$1" 2>/dev/null
}

_cargo_list() {
    cargo install --list 2>/dev/null | awk '$2 ~ /^v.*:/ {print $1}'
}

_krabby_sync() {
    (( KRABBY_SYNC_ENABLED )) || return 0
    local pkglist_file="$HOME/dotfiles/pkglist-cargo.txt" new_crates_list="$(_cargo_list)"
    [[ "$1" == "$new_crates_list" ]] && return 0
    mkdir -p "${pkglist_file%/*}"
    echo "$new_crates_list" > "$pkglist_file"
}

_krabby_update() {
    local upgraded_crates=() tmpfile=$(mktemp)
    trap 'rm -f "$tmpfile"' RETURN

    {   while read -r crate_name crate_version _; do
            [[ $crate_version == v*: ]] || continue
            crate_version="${crate_version#v}"; crate_version="${crate_version%:}"
            local prefix
            case ${#crate_name} in
                1) prefix="1/$crate_name" ;;
                2) prefix="2/$crate_name" ;;
                3) prefix="3/${crate_name:0:1}/$crate_name" ;;
                *) prefix="${crate_name:0:2}/${crate_name:2:2}/$crate_name" ;;
            esac
            local latest
            latest=$(curl -sf "https://index.crates.io/$prefix" | grep -oP '"vers":"\K[^"]+' | tail -1)
            [[ -n "$latest" && "$crate_version" != "$latest" ]] && echo "$crate_name $crate_version $latest"
        done < <(cargo install --list 2>/dev/null)
    } > "$tmpfile" &
    spinner "$!" "Checking crates.io..."

    while read -r crate_name old_version new_version; do
        if [[ "$crate_name" == "sudo-rs" ]]; then
            _handle_sudo_rs "$old_version" "$new_version" && upgraded_crates+=("$crate_name: $old_version -> $new_version")
            continue
        fi
        echo "Upgrading $crate_name ($old_version -> $new_version)..."
        if _krabby_compile install --force "$crate_name"; then
            upgraded_crates+=("$crate_name: $old_version -> $new_version")
        else
            echo "Failed to compile $crate_name"
        fi
    done < "$tmpfile"

    (( ${#upgraded_crates[@]} )) && { echo "Upgraded binaries:"; printf '  -> %s\n' "${upgraded_crates[@]}"; }
}

_handle_sudo_rs() {
    local cargo_bin_dir="$HOME/.cargo/bin" backup_dir="${XDG_STATE_HOME:-$HOME/.local/state}/sudo-rs/v$1"
    local live_sudo="$cargo_bin_dir/sudo"

    echo "Upgrading sudo-rs ($1 -> $2)..."

    "$live_sudo" mkdir -p "$backup_dir"
    "$live_sudo" cp -a "$cargo_bin_dir/"{sudo,visudo,su} "$backup_dir/" \
        || { echo "Abort: could not backup sudo-rs binaries."; return 1; }

    "$backup_dir/sudo" true 2>/dev/null || { echo "Abort: backup verification failed."; return 1; }

    if _krabby_compile install --force sudo-rs; then
        "$backup_dir/sudo" chown root:root "$cargo_bin_dir/"{sudo,visudo,su}
        "$backup_dir/sudo" chmod 4755 "$cargo_bin_dir/"{sudo,su}
        "$backup_dir/sudo" chmod 755 "$cargo_bin_dir/visudo"
        echo "Fallback retained at: $backup_dir"
    else
        echo "Compilation failed. Restoring backup."
        "$backup_dir/sudo" cp -a "$backup_dir/"{sudo,visudo,su} "$cargo_bin_dir/"
        return 1
    fi
}

_krabby_get_count() {
    local instruction_count=0
    [[ -n "$1" ]] && instruction_count=$(echo -n "$1" | tr '\n' '\0' | xargs -0 -r objdump -d 2>/dev/null | grep -E -ic '\b(bzhi|mulx|pdep|pext|rorx|sarx|shlx|shrx|vgather[a-z0-9]*|vpbroadcast[a-z0-9]*|vpermd|vpermq|vperm2i128)\b')
    echo "${instruction_count:-0}"
}

_krabby_compile() {
    local cargo_cmd="$1" cargo_arg="$2" bin_target="$3" bin_name="${3%@*}" work_dir=$(mktemp -d) cached_profile=""
    trap 'rm -rf "$work_dir" 2>/dev/null; trap "exit 130" INT TERM' RETURN
    trap 'rm -rf "$work_dir" 2>/dev/null; exit 130' INT TERM

    if [[ "$cargo_cmd" == "install" ]]; then
    	local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/v3compile"
        mkdir -p "$work_dir/stage"
        echo "Starting Krabby build for: $bin_name (Mode: $cargo_cmd)"
        [[ -f "$cache_dir/$bin_name" ]] && read -r cached_profile < "$cache_dir/$bin_name" && [[ -n "$cached_profile" ]] && echo "Found global cache: [$cached_profile]"
    else
        echo "Starting Krabby build for local project (Mode: $cargo_cmd)"
        [[ -f ".v3compile" ]] && read -r cached_profile < ".v3compile" && [[ -n "$cached_profile" ]] && echo "Found project override: [$cached_profile]"
    fi

    _compile_profile() {
        RUSTC_BOOTSTRAP=1 CC=clang CXX=clang++ AR=llvm-ar RANLIB=llvm-ranlib CFLAGS="$2" CXXFLAGS="$3" RUSTFLAGS="$4" \
        ${5:+timeout} ${5:+"$5"} cargo "$cargo_cmd" "${CARGO_COMMON_ARGS[@]}" $cargo_arg ${bin_target:+"$bin_target"} > "$work_dir/build.log" 2>&1 &
        spinner "$!" "Compiling profile: [$1]..." || {
            [[ -n "$5" && $? -eq 124 ]] && return 124
            echo "Build failed for profile [$1]!"
            echo "$(< "$work_dir/build.log")"; return 1
        }
    }

    if [[ -n "$cached_profile" ]]; then
        echo "Skipping FFI probes. Fast-tracking..."
        if [[ "$cached_profile" == "crosslto" ]]; then
            _compile_profile "crosslto" "$COMMON_CFLAGS" "$COMMON_CXXFLAGS" "$COMMON_RUSTFLAGS -C linker=clang -C linker-plugin-lto" || return 1
        else
            _compile_profile "rust" "" "" "$COMMON_RUSTFLAGS" || return 1
        fi
        echo "Final binary built via fast-path [$cached_profile]."
        return 0
    fi

    echo "No cache found. Initiating FFI probes..."
    _compile_profile "crosslto" "$COMMON_CFLAGS" "$COMMON_CXXFLAGS" "$COMMON_RUSTFLAGS -C linker=clang -C linker-plugin-lto" || return 1

    if [[ "$cargo_cmd" == "install" ]]; then
        local bin_path=$(cargo install --list 2>/dev/null | awk -v c="$bin_name" -v home="$HOME" \
            '$0 ~ "^"c" v" {m=1; next} /^[^[:space:]]/ {m=0} m {f=home "/.cargo/bin/" $1; if (system("test -f " f) == 0) print f}')
        local count_crosslto=$(_krabby_get_count "$bin_path")
        xargs -d'\n' -r cp -a --target-directory="$work_dir/stage/" <<< "$bin_path"

        _compile_profile "noc" "" "" "$COMMON_RUSTFLAGS -C linker=clang -C linker-plugin-lto"
        local count_noc=$(_krabby_get_count "$bin_path")

        echo "--- PROBE RESULT ---"
        echo "crosslto       : ${count_crosslto:-0}"
        echo "noc (canary)   : ${count_noc:-0}"
        echo "--------------------"

        if [[ "${count_crosslto:-0}" != "${count_noc:-0}" ]]; then
            local winning_profile="crosslto"
            echo "C/C++ dependencies detected. Restoring staged crosslto binary..."
            cp -a "$work_dir/stage/"* "$HOME/.cargo/bin/"
        else
            local winning_profile="rust"
            echo "No C/C++ FFI benefits detected. Compiling pure rust profile..."
            _compile_profile "rust" "" "" "$COMMON_RUSTFLAGS" || return 1
        fi

        mkdir -p "$cache_dir"
        echo "$winning_profile" > "$cache_dir/$bin_name"
    else
        echo "Testing incremental cache with noc profile (3s timeout)..."
        _compile_profile "noc" "" "" "$COMMON_RUSTFLAGS -C linker=clang -C linker-plugin-lto" "3s"
        case $? in
            124) echo "Cargo is rebuilding FFI (exceeded 3s)! crosslto takes the crown." 
            	 local winning_profile="crosslto" ;;
              0) echo "Incremental build finished instantly! No FFI flags mattered."
                 _compile_profile "rust" "" "" "$COMMON_RUSTFLAGS" || return 1
                 local winning_profile="rust" ;;
              *) echo "Probe failed unexpectedly. Aborting."; return 1 ;;
        esac
        echo "$winning_profile" > .v3compile
    fi
}

_krabby_main() {
    case "${1:-}" in
        help|-h|--help) echo '
🦀 krabby package manager - Extreme performance cargo wrapper

USAGE:
  krabby [SUBCOMMAND] [ARGS...]

SUBCOMMANDS:
  install <binary>    Install or compile a crate from crates.io with FFI profiling
  uninstall <binary>  Uninstall crate
  [no args]           Build a local project (auto-detects Cargo.toml in current dir)
  update              Upgrade all installed cargo crates
  list                List all installed cargo binaries
  help, -h            Show this help message
' ;;
        update|upgrade) _krabby_update ;;
        list) echo "📦 Installed Cargo Binaries:"; cargo install --list ;;
    	install) shift
        		 [[ -z "${1:-}" ]] && { echo "Error: 'krabby install' requires at least one crate name."; exit 1; }
        		 local old_crates_list="$(_cargo_list)"
        		 for _bin in "$@"; do
        		     _krabby_compile install --force "$_bin" || { echo "Install failed for: $_bin"; exit 1; }
        		 done
        		 _krabby_sync "$old_crates_list" ;;
        uninstall) shift
            	   local old_crates_list="$(_cargo_list)"
            	   for _bin in "$@"; do
                		[[ "$_bin" == "sudo-rs" ]] && { echo "Warning: skipping sudo-rs — refusing to uninstall it via krabby. Remove it manually if you're certain."; continue; }
                		cargo uninstall "$_bin"
            	   done
            	   _krabby_sync "$old_crates_list" ;;
        *) _krabby_compile build "--release" || { echo "Build failed!"; exit 1; } ;;
    esac
}

_krabby_main "$@"
